# Claude API key (can also be passed per-request via x-api-key header)
ANTHROPIC_API_KEY=your-api-key-here

# Port where this proxy listens
PORT=8000

# -----------------------------------------------------------------------------
# Upstream proxy — route PromptZero → api.anthropic.com through another proxy
# (Burp Suite, mitmproxy, Charles, corporate egress, …). Useful to verify in a
# demo that nothing sensitive leaves the machine. Leave commented out for a
# direct connection to api.anthropic.com.
# -----------------------------------------------------------------------------

# UPSTREAM_PROXY=http://127.0.0.1:8080

# If your upstream proxy does TLS interception (Burp does), either:
#   a) export Burp's CA cert as PEM and trust it explicitly:
#        UPSTREAM_CA_BUNDLE=/Users/you/burp-ca.pem
#   b) or skip TLS verification entirely (insecure, demo-only):
#        UPSTREAM_VERIFY=false

# UPSTREAM_CA_BUNDLE=
# UPSTREAM_VERIFY=true

# -----------------------------------------------------------------------------
# System hint — prepend a short `system` block to every /v1/messages request
# explaining the redaction convention so Claude does not refuse pentest/security
# analysis because the synthetic hostnames (*.example.com) look like RFC
# documentation references. Default ON. Disable if your client already injects
# its own system prompt or you want to benchmark raw substitution behaviour.
# -----------------------------------------------------------------------------

# INJECT_SYSTEM_HINT=1

# -----------------------------------------------------------------------------
# NER PERSON / ORGANIZATION detection. Default ON.
#
# spaCy NER is the #1 source of substitution false positives in pentest
# workflows — pentest vocabulary (Banner, ACLs, Investigate, Direct,
# Network, Attacker, Reconnaissance, …) wasn't in spaCy's training corpus
# and every capitalised English word at a bullet start risks misfiring as
# PERSON / ORG. Set DETECT_PERSON_ORG=0 for "pentest mode": drops these
# two entity types entirely, leaving every other detector (regex IPv4/IPv6,
# hostnames, emails, tokens, credentials, country IDs) working unchanged.
# Regex-based detection is essentially FP-free in practice.
#
# Keep it ON when the input is human-written narrative (incident reports,
# document summaries) where you want to catch auditor / contact / client
# names.
# -----------------------------------------------------------------------------

# DETECT_PERSON_ORG=1

# -----------------------------------------------------------------------------
# Debug audit — record the sanitized upstream payload + desanitized response of
# every /v1/messages call into an in-memory ring buffer (per session), surfaced
# via GET /sessions/<id>/audit. Used by examples/poc/integration_test.py to
# assert "no real PII reached Anthropic" end-to-end. Off by default — the audit
# log still contains the conversation content and should not be exposed in prod.
# -----------------------------------------------------------------------------

# DEBUG_AUDIT=1
