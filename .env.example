# Claude API key (can also be passed per-request via x-api-key header)
ANTHROPIC_API_KEY=your-api-key-here

# Port where this proxy listens
PORT=8000

# -----------------------------------------------------------------------------
# Upstream proxy — route PromptZero → api.anthropic.com through another proxy
# (Burp Suite, mitmproxy, Charles, corporate egress, …). Useful to verify in a
# demo that nothing sensitive leaves the machine. Leave commented out for a
# direct connection to api.anthropic.com.
# -----------------------------------------------------------------------------

# UPSTREAM_PROXY=http://127.0.0.1:8080

# If your upstream proxy does TLS interception (Burp does), either:
#   a) export Burp's CA cert as PEM and trust it explicitly:
#        UPSTREAM_CA_BUNDLE=/Users/you/burp-ca.pem
#   b) or skip TLS verification entirely (insecure, demo-only):
#        UPSTREAM_VERIFY=false

# UPSTREAM_CA_BUNDLE=
# UPSTREAM_VERIFY=true
